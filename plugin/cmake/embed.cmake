# The editor page (site/editor/: emu/build.sh) as C arrays in the plugin: cmake -DSRC=dir -DOUT=file -P embed.cmake
set(FILES index.html:text/html editor.js:text/javascript prysm.js:text/javascript prysm.wasm:application/wasm)
set(body "// generated by plugin/cmake/embed.cmake from site/editor/\n#include \"assets.h\"\n")
set(table "")
set(i 0)
foreach(entry ${FILES})
    string(REPLACE ":" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 mime)
    file(READ "${SRC}/${name}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char a${i}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", a${i}, ${size}, \"${mime}\"},\n")
    math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "${body}const PrysmAsset prysm_assets[] = {\n${table}};\nconst size_t prysm_assets_n = ${i};\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
